# Optional. Without a key, FactLayer uses the local extractor + judge
# (enough to run the demo). With a key, extraction and judging improve.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
EMBED_MODEL=token-jaccard
LLM_BASE_URL=https://api.openai.com/v1

MAX_UPLOAD_MB=25
BATCH_PAGES=3
BLOCK_THRESHOLD=0.32
LLM_CONCURRENCY=3
MIN_FACT_CONFIDENCE=0.4
DATABASE_URL=sqlite:///./app.db
UPLOAD_DIR=../data/uploads
